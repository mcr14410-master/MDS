< ./cmm/fehler/KAPUTT.layout.xml
--{{boundary}}
Content-Disposition: form-data; name="files"; filename="notiz.docx"
Content-Type: application/octet-stream

< ./cmm/fehler/notiz.docx
--{{boundary}}--

