### ============================================
### Vacation Management API Tests
### ============================================
### Requires VS Code REST Client Extension

@baseUrl = http://localhost:3001/api
@contentType = application/json

### Login as Admin
# @name login
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "username": "admin",
  "password": "admin123"
}

### Set token from login response
@token = {{login.response.body.token}}

### ============================================
### VACATION TYPES
### ============================================

### Get all vacation types
GET {{baseUrl}}/vacation-types
Authorization: Bearer {{token}}

### Get single type
GET {{baseUrl}}/vacation-types/1
Authorization: Bearer {{token}}

### Create vacation type
POST {{baseUrl}}/vacation-types
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "name": "Elternzeit",
  "color": "#EC4899",
  "affects_balance": false,
  "allows_partial_day": false,
  "sort_order": 8
}

### Update vacation type
PUT {{baseUrl}}/vacation-types/1
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "color": "#10B981"
}

### ============================================
### HOLIDAYS
### ============================================

### Get holidays for current year (auto-generates if needed)
GET {{baseUrl}}/holidays?year=2025
Authorization: Bearer {{token}}

### Get holidays for 2026
GET {{baseUrl}}/holidays?year=2026
Authorization: Bearer {{token}}

### Check if date is a holiday
GET {{baseUrl}}/holidays/check?date=2025-12-25
Authorization: Bearer {{token}}

### Get holidays in date range
GET {{baseUrl}}/holidays/range?startDate=2025-01-01&endDate=2025-06-30
Authorization: Bearer {{token}}

### Manually generate holidays for a year
POST {{baseUrl}}/holidays/generate
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "year": 2027
}

### Add custom holiday (Betriebsferien)
POST {{baseUrl}}/holidays
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "date": "2025-12-24",
  "name": "Betriebsferien"
}

### Add bridge day
POST {{baseUrl}}/holidays
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "date": "2025-05-02",
  "name": "Brückentag"
}

### Delete holiday
DELETE {{baseUrl}}/holidays/15
Authorization: Bearer {{token}}

### ============================================
### VACATION ENTITLEMENTS
### ============================================

### Get all entitlements for a year
GET {{baseUrl}}/vacation-entitlements?year=2025
Authorization: Bearer {{token}}

### Get vacation balances (with used/remaining calculated)
GET {{baseUrl}}/vacation-entitlements/balances?year=2025
Authorization: Bearer {{token}}

### Get single user's balance
GET {{baseUrl}}/vacation-entitlements/balance/2?year=2025
Authorization: Bearer {{token}}

### Create entitlement for a user
POST {{baseUrl}}/vacation-entitlements
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "user_id": 2,
  "year": 2025,
  "total_days": 30,
  "carried_over": 5,
  "note": "5 Tage Resturlaub 2024"
}

### Initialize entitlements for all users for a year
POST {{baseUrl}}/vacation-entitlements/initialize
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "year": 2025
}

### Update entitlement
PUT {{baseUrl}}/vacation-entitlements/1
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "adjustment": 2,
  "note": "2 Tage Sonderurlaub Hochzeit"
}

### ============================================
### VACATIONS (Absences)
### ============================================

### Get all vacations
GET {{baseUrl}}/vacations?year=2025
Authorization: Bearer {{token}}

### Get vacations for calendar (month view)
GET {{baseUrl}}/vacations/calendar?month=1&year=2025
Authorization: Bearer {{token}}

### Get vacations for calendar (year view)
GET {{baseUrl}}/vacations/calendar?year=2025
Authorization: Bearer {{token}}

### Check overlap before creating
POST {{baseUrl}}/vacations/check-overlap
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "user_id": 2,
  "start_date": "2025-02-10",
  "end_date": "2025-02-14"
}

### Create vacation (Urlaub - full days)
POST {{baseUrl}}/vacations
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "user_id": 2,
  "type_id": 1,
  "start_date": "2025-02-10",
  "end_date": "2025-02-14",
  "note": "Skiurlaub"
}

### Create sick leave
POST {{baseUrl}}/vacations
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "user_id": 2,
  "type_id": 2,
  "start_date": "2025-01-20",
  "end_date": "2025-01-22",
  "note": "Erkältung"
}

### Create Zeitausgleich (partial day with times)
POST {{baseUrl}}/vacations
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "user_id": 2,
  "type_id": 4,
  "start_date": "2025-01-24",
  "end_date": "2025-01-24",
  "start_time": "14:00",
  "end_time": "17:00",
  "note": "Arzttermin"
}

### Get single vacation
GET {{baseUrl}}/vacations/1
Authorization: Bearer {{token}}

### Update vacation
PUT {{baseUrl}}/vacations/1
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "end_date": "2025-02-16",
  "note": "Verlängert um 2 Tage"
}

### Delete vacation
DELETE {{baseUrl}}/vacations/1
Authorization: Bearer {{token}}

### ============================================
### VACATION SETTINGS
### ============================================

### Get all settings
GET {{baseUrl}}/vacation-settings
Authorization: Bearer {{token}}

### Get single setting
GET {{baseUrl}}/vacation-settings/default_vacation_days
Authorization: Bearer {{token}}

### Update single setting
PUT {{baseUrl}}/vacation-settings/max_concurrent_helper
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "value": "2"
}

### Update multiple settings at once
PUT {{baseUrl}}/vacation-settings
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "default_vacation_days": "30",
  "max_concurrent_helper": "1",
  "max_concurrent_operator": "2"
}

### ============================================
### URLAUB ÜBER DEN JAHRESWECHSEL
### Tage werden je Kalenderjahr aufgeteilt (days_by_year),
### Saldo/Listen/PDFs rechnen mit dem Anteil des Jahres
### Voraussetzung: Feiertage 2026/2027 (BY) generiert, Anspruch 2026/2027 für User 2
### ============================================

### JW-1: Anlegen 21.12.2026–08.01.2027 → calculated_days 12, days_by_year {"2026": 8, "2027": 4}
# @name jwCreate
POST {{baseUrl}}/vacations
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "user_id": 2,
  "type_id": 1,
  "start_date": "2026-12-21",
  "end_date": "2027-01-08",
  "skip_overlap_check": true
}

### JW-2: Daten ändern 28.12.2026–15.01.2027 → {"2026": 4, "2027": 9}
PUT {{baseUrl}}/vacations/{{jwCreate.response.body.id}}
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "start_date": "2026-12-28",
  "end_date": "2027-01-15",
  "skip_overlap_check": true
}

### JW-3: Nur Notiz ändern → days_by_year bleibt
PUT {{baseUrl}}/vacations/{{jwCreate.response.body.id}}
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "note": "nur Notiz"
}

### JW-4: Liste 2026 → enthält den Urlaub, days_in_year 4
GET {{baseUrl}}/vacations?year=2026&user_id=2
Authorization: Bearer {{token}}

### JW-5: Liste 2027 → enthält den Urlaub ebenfalls, days_in_year 9
GET {{baseUrl}}/vacations?year=2027&user_id=2
Authorization: Bearer {{token}}

### JW-6: Liste 2025 → Urlaub nicht enthalten
GET {{baseUrl}}/vacations?year=2025&user_id=2
Authorization: Bearer {{token}}

### JW-7: Saldo 2026 → nur 4 Tage angerechnet
GET {{baseUrl}}/vacation-entitlements/balance/2?year=2026
Authorization: Bearer {{token}}

### JW-8: Saldo 2027 → 9 Tage angerechnet
GET {{baseUrl}}/vacation-entitlements/balance/2?year=2027
Authorization: Bearer {{token}}

### JW-9: Eigener Antrag 30.12.2026–04.01.2027 → pending, {"2026": 2, "2027": 1}
# @name jwRequest
POST {{baseUrl}}/vacations/request
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "type_id": 1,
  "start_date": "2026-12-30",
  "end_date": "2027-01-04"
}

### JW-10: Meine Anträge 2027 → Antrag enthalten, days_in_year 1
GET {{baseUrl}}/vacations/my-requests?year=2027
Authorization: Bearer {{token}}

### JW-11: Ablehnen
POST {{baseUrl}}/vacations/{{jwRequest.response.body.id}}/reject
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "reason": "Test Jahreswechsel"
}

### JW-12: Erneut einreichen mit neuen Daten → {"2026": 8, "2027": 4}
POST {{baseUrl}}/vacations/{{jwRequest.response.body.id}}/resubmit
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "start_date": "2026-12-21",
  "end_date": "2027-01-08"
}

### JW-13: check-overlap → calculatedDays weiterhin Gesamtzahl (12)
POST {{baseUrl}}/vacations/check-overlap
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "user_id": 2,
  "start_date": "2026-12-21",
  "end_date": "2027-01-08"
}

### JW-14: PDF Mitarbeiter 2027 → Zeile "9 von 13", Gesamt/Rest nur mit Anteil 2027
GET {{baseUrl}}/vacations/export/user/2?year=2027
Authorization: Bearer {{token}}

### JW-15: PDF alle Mitarbeiter 2027
GET {{baseUrl}}/vacations/export/all?year=2027
Authorization: Bearer {{token}}

### JW-16: PDF eigenes Jahr 2027
GET {{baseUrl}}/vacations/export/my-year?year=2027
Authorization: Bearer {{token}}

### JW-17: Jahr 2028 initialisieren → Übertrag = Rest 2027 (mit Anteil gerechnet)
POST {{baseUrl}}/vacation-entitlements/initialize
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "year": 2028
}

### JW-18: Terminal-Info → vacation_days_remaining gefüllt (vorher immer null)
GET {{baseUrl}}/time-tracking/entries/user-info?pin_code=1234
Authorization: Bearer {{token}}

### JW-Aufräumen
DELETE {{baseUrl}}/vacations/{{jwCreate.response.body.id}}
Authorization: Bearer {{token}}

###
DELETE {{baseUrl}}/vacations/{{jwRequest.response.body.id}}
Authorization: Bearer {{token}}

### ============================================
### EIGENE ANTRÄGE BEARBEITEN / ZURÜCKZIEHEN
### Nur eigene Anträge mit Status pending/rejected (Recht vacations.read).
### Bearbeiten eines abgelehnten Antrags reicht ihn erneut ein,
### Zurückziehen setzt status = 'cancelled' (zählt nirgends mehr).
### ============================================

### EA-1: Eigenen Antrag stellen
# @name eaRequest
POST {{baseUrl}}/vacations/request
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "type_id": 1,
  "start_date": "2026-11-02",
  "end_date": "2026-11-06",
  "note": "alt"
}

### EA-2: Ausstehenden Antrag ändern → 200, bleibt pending, Tage neu (4)
PUT {{baseUrl}}/vacations/{{eaRequest.response.body.id}}/own
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "type_id": 1,
  "start_date": "2026-11-09",
  "end_date": "2026-11-12",
  "note": "neu"
}

### EA-3: Ende vor Start → 400
PUT {{baseUrl}}/vacations/{{eaRequest.response.body.id}}/own
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "type_id": 1,
  "start_date": "2026-11-12",
  "end_date": "2026-11-09"
}

### EA-4: Typ nur per Direkteintrag (z. B. Krank) → 400
PUT {{baseUrl}}/vacations/{{eaRequest.response.body.id}}/own
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "type_id": 2,
  "start_date": "2026-11-09",
  "end_date": "2026-11-12"
}

### EA-5: Pflichtfelder fehlen → 400
PUT {{baseUrl}}/vacations/{{eaRequest.response.body.id}}/own
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "note": "nur Notiz"
}

### EA-6: Unbekannte ID → 404
POST {{baseUrl}}/vacations/999999/withdraw
Authorization: Bearer {{token}}

### EA-7: Antrag eines anderen Mitarbeiters (ID anpassen) → 403
PUT {{baseUrl}}/vacations/2/own
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "type_id": 1,
  "start_date": "2026-11-16",
  "end_date": "2026-11-17"
}

### EA-8: Ablehnen (als Genehmiger)
POST {{baseUrl}}/vacations/{{eaRequest.response.body.id}}/reject
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "reason": "Engpass"
}

### EA-9: Abgelehnten Antrag ändern → wieder pending, rejection_reason/approved_by geleert
PUT {{baseUrl}}/vacations/{{eaRequest.response.body.id}}/own
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "type_id": 5,
  "start_date": "2026-11-30",
  "end_date": "2026-12-01"
}

### EA-10: Zurückziehen → status cancelled
POST {{baseUrl}}/vacations/{{eaRequest.response.body.id}}/withdraw
Authorization: Bearer {{token}}

### EA-11: Erneut zurückziehen → 400
POST {{baseUrl}}/vacations/{{eaRequest.response.body.id}}/withdraw
Authorization: Bearer {{token}}

### EA-12: Zurückgezogenen genehmigen → 400
POST {{baseUrl}}/vacations/{{eaRequest.response.body.id}}/approve
Authorization: Bearer {{token}}

### EA-13: Liste ohne status-Filter → zurückgezogener Antrag nicht enthalten
GET {{baseUrl}}/vacations?year=2026&user_id=1
Authorization: Bearer {{token}}

### EA-14: Liste mit status=cancelled → enthalten
GET {{baseUrl}}/vacations?status=cancelled&user_id=1
Authorization: Bearer {{token}}

### EA-15: Genehmigten eigenen Urlaub zurückziehen (ID anpassen) → 400
POST {{baseUrl}}/vacations/1/withdraw
Authorization: Bearer {{token}}
