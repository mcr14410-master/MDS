{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MDS-Backend (Debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "MDS-Frontend (Debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "MDS-Start (Backend + Frontend)",
      "configurations": ["MDS-Backend (Debug)", "MDS-Frontend (Debug)"]
    }
  ]
}
