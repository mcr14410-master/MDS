<Project Sdk="Microsoft.NET.Sdk">

  <!-- TopSolid'Automation läuft unter .NET Framework 4.8 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>TS_SN_Generator</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <TopSolidBin>C:\Program Files\TopSolid\TopSolid 7.17\bin</TopSolidBin>
  </PropertyGroup>

  <!-- Direkt die DLLs der installierten Version referenzieren (passt garantiert zu 7.17) -->
  <ItemGroup>
    <Reference Include="TopSolid.Kernel.Automating">
      <HintPath>$(TopSolidBin)\TopSolid.Kernel.Automating.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="TopSolid.Cam.NC.Kernel.Automating">
      <HintPath>$(TopSolidBin)\TopSolid.Cam.NC.Kernel.Automating.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.ServiceModel" />
  </ItemGroup>

</Project>
