# Einheitliche Zeilenenden (LF) für alle Textdateien
* text=auto eol=lf

# Explizit für Code-Dateien
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-Batchdateien brauchen CRLF (cmd.exe)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binärdateien nicht anfassen
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
