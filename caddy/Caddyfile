# MDS Caddyfile - Reverse Proxy für Frontend + Backend API
:80 {
  # Static Frontend
  root * /srv/frontend
  encode zstd gzip

  # Caching: Assets lange cachen, alles andere vom Frontend nie (siehe SPA Fallback)
  @assets {
    path *.js *.css *.png *.jpg *.jpeg *.gif *.svg *.ico *.webp *.woff *.woff2
  }
  header @assets Cache-Control "public, max-age=31536000, immutable"

  # API Proxy zu Backend
  handle /api/* {
    reverse_proxy backend:5000 {
      flush_interval -1
      transport http {
        keepalive 30s
      }
    }
  }

  # Build-Assets: fehlende Dateien (z. B. Chunks einer alten Version) mit 404 statt index.html
  handle /assets/* {
    file_server
  }

  # Fehlerantworten (z. B. 404 unter /assets/) nie cachen – sonst trügen sie den Asset-Header
  handle_errors {
    header Cache-Control "no-store"
  }

  # SPA Fallback
  handle {
    # index.html nie cachen – auch nicht unter Deep-Links wie /parts/12, sonst lädt
    # der Browser nach einem Deploy die alte Version mit gelöschten Assets.
    # „?“ setzt nur, wenn noch kein Cache-Control da ist (Assets behalten ihres)
    header ?Cache-Control "no-store"
    try_files {path} /index.html
    file_server
  }
}
